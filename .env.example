CLIPFAST_SUPABASE_URL=https://your-project.supabase.co
CLIPFAST_SUPABASE_ANON_KEY=your-public-anon-key

# Production: set the proxy URL to route auth through Cloudflare Worker.
# When set, CLIPFAST_SUPABASE_URL / ANON_KEY are ignored at runtime.
CLIPFAST_AUTH_PROXY_URL=https://clipfast-auth-proxy.clipfast-auth-proxy.workers.dev
